# Optional. The CLI loads .env from the current directory automatically.
ALCHEMY_API_KEY=

BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# Maximum total loss (fees, gas, and slippage) per wallet/source-network group.
MAX_ROUTE_LOSS_PCT=15

# Defer Ethereum transactions when current or planned gas price reaches this ceiling.
# Unit: gwei. Defaults to 1 if omitted.
ETHEREUM_GAS_PRICE_LIMIT_GWEI=1
